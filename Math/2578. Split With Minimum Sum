class Solution {
public:
    int splitNum(int num) {
        vector <int> digits;
        int num1=0;
        int num2=0;
        while(num>0){
            int digit = num%10;
            digits.push_back(digit);
            num/=10;
        }
        sort(digits.begin(), digits.end());
        for(int i=0; i<digits.size(); i++){
            if(i%2==0){
                num1= num1*10+digits[i];
            }
            else{
                num2=num2*10+digits[i];
            }
        }
        return num1 + num2;
    }
};
