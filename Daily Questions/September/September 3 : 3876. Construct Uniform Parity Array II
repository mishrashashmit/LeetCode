class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
        int minOdd = INT_MAX;

        //finding smallest odd number
        for(int x : nums1){
            if(x%2!=0){
                minOdd=min(minOdd, x);
            }
        }

        //no odd , all even - already valid
        if(minOdd == INT_MAX){
            return true;
        }

        //even number smaller than odd
        for(int x : nums1){
            if(x%2==0 && x < minOdd){
                return false;
            }
        }
        return true;
    }
};
