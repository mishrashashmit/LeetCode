class Solution {
public:
    bool checkDivisibility(int n) {
        int sum=0;
        int prod=1;
        int copy = n;
        while(copy != 0){
            int digit=copy%10;
            sum=sum+digit;
            prod = prod*digit;
            copy/=10;
        }
        if(n%(sum+prod)==0){
            return true;
        }
        return false;
    }
};
